{
  "name": "nubly-landing-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u NODE_OPTIONS next dev --turbopack -H 0.0.0.0 -p 3002",
    "dev:lan": "env -u NODE_OPTIONS next dev -H 0.0.0.0 -p 3002",
    "build": "env -u NODE_OPTIONS next build --turbopack",
    "start": "env -u NODE_OPTIONS next start",
    "lint": "eslint",
    "test": "vitest run",
    "build:functions": "node functions/scripts/sync-shared-feedback.mjs && rm -rf functions/lib && cd functions && npx tsc",
    "emulators": "npm run build:functions && node scripts/start-emulators.mjs",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=localhost:8080 node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.19.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "firebase-tools": "^15.19.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
